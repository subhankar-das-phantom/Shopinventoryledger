# ==============================================================================
# Shop Inventory Ledger - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS: Copy this file to `backend/.env` and update the values as needed.
# NEVER commit files containing real credentials or secrets to version control.
# ==============================================================================

# Server Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend HTTP Server Port
PORT=5000

# MongoDB Connection String:
# - For local standalone MongoDB:
MONGODB_URI=mongodb://localhost:27017/shop_inventory_ledger
# - For MongoDB Atlas replica set (enables multi-document ACID transactions):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/shop_inventory_ledger?retryWrites=true&w=majority

# JWT Authentication Configuration
# MUST be a cryptographically secure random string with at least 32 characters
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters_for_jwt

# JWT Token Expiry (e.g. '7d', '24h', '30d')
JWT_EXPIRES_IN=7d

# Allowed CORS Origin for Frontend Client
FRONTEND_URL=http://localhost:5173
