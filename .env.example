# Environment configuration for Shop Inventory Ledger
NODE_ENV=development
PORT=5000

# MongoDB Connection URI (standalone for local dev or replica set URI)
MONGODB_URI=mongodb://localhost:27017/shop_inventory_ledger

# Authentication
JWT_SECRET=super_secret_jwt_key_must_be_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS allowed frontend origin
FRONTEND_URL=http://localhost:5173
